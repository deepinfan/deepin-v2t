# V-Input 配置文件示例
# 配置文件路径: ~/.config/vinput/config.toml

# ============================================================
# ASR (语音识别) 配置
# ============================================================
[asr]
# 模型目录路径（开发环境）
model_dir = "/home/deepin/deepin-v2t/models/streaming"
# 采样率 (Hz)
sample_rate = 16000
# 特征维度
feat_dim = 80
# 解码方法 ("greedy_search" 或 "modified_beam_search")
decoding_method = "greedy_search"
# 最大活跃路径数（越大越准确但越慢）
max_active_paths = 2

# ============================================================
# VAD (语音活动检测) 配置
# ============================================================

# Silero VAD 模型配置
[vad.silero]
model_path = "models/silero-vad/silero_vad.onnx"
sample_rate = 16000
frame_size = 512

# 能量门限配置（噪声过滤）
[vad.energy_gate]
enabled = true
noise_multiplier = 2.5
baseline_alpha = 0.95
initial_baseline = 0.001

# 迟滞控制器配置（语音/静音状态切换）
[vad.hysteresis]
# 麦克风灵敏度（0.0-0.4，越小越灵敏）
start_threshold = 0.1
# 静音结束阈值
end_threshold = 0.35
# 最小语音时长 (ms)
min_speech_duration_ms = 100
# 最小静音时长 (ms)
min_silence_duration_ms = 500
# 最大候选间隙帧数
max_candidate_gap_frames = 2

# Pre-roll 缓冲配置
[vad.pre_roll]
enabled = true
duration_ms = 250
capacity = 4000

# 短爆发过滤器配置
[vad.transient_filter]
enabled = true
max_duration_ms = 80
rms_threshold = 0.05

# ============================================================
# 端点检测配置（自动断句上屏）
# ============================================================
[endpoint]
# 最大语音长度 (ms)，连续说话超过此长度会自动断句上屏（0 表示不限制）
max_speech_duration_ms = 20000
# 语音结束后的静音等待时间 (ms)
trailing_silence_ms = 800

# ============================================================
# 标点模型目录
# ============================================================
punct_model_dir = "/home/deepin/deepin-v2t/models/punct-ct-transformer"

